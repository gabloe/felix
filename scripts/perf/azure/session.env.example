# Copy to session.env and fill in. session.env is gitignored — it holds a real
# secret and must never be committed. Load it before a run with:
#
#   set -a; source scripts/perf/azure/session.env; set +a
#
# then run ./session.sh / ./run.sh / ./teardown.sh.

# --- Azure ---
AZ_SUBSCRIPTION=<subscription-guid>

# --- session ---
SESSION=t1-a
TIER=t1                     # t1 (one zone) | t2 (three zones)
LOCATION=eastus2
RELEASE_TAG=v0.3.0          # the broker/control-plane artifacts under test
# LOADGEN_REF defaults to main, which now contains felix-loadgen (merged in
# #370). Override only to build the instrument from a branch under review.
# LOADGEN_REF=main

# --- IdP (Entra app registration, client-credentials) ---
IDP_TENANT_ID=<tenant-guid>
IDP_CLIENT_ID=<felix-perf app client id>
# What to request the token FOR. The bare client id works too; the audience
# the tenant is registered with is read off the minted token, not from here.
IDP_SCOPE=api://<felix-perf app client id>
IDP_CLIENT_SECRET=<the client secret — the ONE real secret here>
