/target
**/target
# Cross-platform build trees (e.g. a Linux container reproducing a CI failure
# against a bind-mounted checkout). These are cargo output like any other, and
# 700MB of them showing as untracked is alarming in a way it should not be.
/target-*
**/*.rs.bk
**/*.pdb
**/*.dSYM/
**/*.dSYM
.cargo/
!.cargo/config.toml
.env
.env.*
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.tmp
*.log
*.bak
*.gz
data/raw/stdout/
data/raw/latency_demo_runs.jsonl
data/derived/*.csv
data/derived/*.parquet
charts/
__pycache__/
*.pyc
coverage.json
lcov.info
# Documentation build output
/site/
site/
docs-site/dist/
docs-site/node_modules/
docs-site/.astro/
.cache/
data/soak/
/crates/felix-storage/fuzz/target
.venv-perf
